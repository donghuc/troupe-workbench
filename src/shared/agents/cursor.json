{
  "id": "cursor",
  "label": "Cursor CLI",
  "detect": ["cursor-agent", "agent"],
  "needs": "Needs a Cursor account",
  "install": {"cmd": "curl https://cursor.com/install -fsS | bash", "host": "cursor.com"},
  "signIn": {"cmd": "cursor-agent login", "terminal": true},
  "docs": "https://cursor.com/docs/cli/overview",
  "agent": {"command": "cursor-agent -p --trust --force --output-format text {prompt}", "output": "text", "modelFlag": "--model", "readOnlyArgs": "--mode=ask"},
  "win": {"install": null}
}
